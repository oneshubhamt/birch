        },
        "lineSpacing": {
          "type": "string",
          "nullable": true,
          "required": false,
          "default": null,
          "enum_domain": "line_spacing"
        },
        "textAlignment": {
          "type": "string",
          "required": false,
          "default": "left",
          "enum_domain": "text_alignment"
        },
        "leftIndent": {
          "type": "integer",
          "required": false,
          "default": 0,
          "min": 0,
          "max_limit": "paragraph_side_indent_max"
        },
        "rightIndent": {
          "type": "integer",
          "required": false,
          "default": 0,
          "min": 0,
          "max_limit": "paragraph_side_indent_max"
        },
        "firstLineIndent": {
          "type": "integer",
          "required": false,
          "default": 0,
          "min": 0,
          "max_limit": "paragraph_first_line_indent_max"
        },
        "dropCap": {
          "type": "boolean",
          "required": false,
          "default": false
        }
      },
      "prosemirror": {
